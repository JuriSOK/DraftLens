# ── macOS ─────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Editors ───────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
.eggs/

# ── Python virtual environments ───────────────────────────────────────
.venv/
venv/
env/
ENV/
.python-version

# ── Environment files ─────────────────────────────────────────────────
.env
.env.*

# ── Notebooks ─────────────────────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ── Build outputs ─────────────────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/
.turbo/

# ── Temporary / generated artifacts ───────────────────────────────────
*.log
tmp/
temp/
.scratch/

# ── Credentials / secrets (belt-and-braces; none are expected here) ───
*.pem
*.key
*.p12
*.pfx
.netrc
credentials.json
secrets.json
*_secret*
*.cookies

# ── Datasets (any location, not just data/) ───────────────────────────
*.parquet
*.feather
*.db
*.sqlite
*.sqlite3

# ── Data ──────────────────────────────────────────────────────────────
# The data directory structure is tracked; data files are not.
# Source data is re-acquirable via scripts/ — see docs/DATA.md.
# Do not commit licensed or restricted data.
data/**
!data/
!data/README.md
!data/source_manifest.csv
!data/raw/
!data/raw/draft_watchlist/
!data/raw/draft_watchlist/draft_watchlist_sources_2027.csv
!data/interim/
!data/processed/
