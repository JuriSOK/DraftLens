{
  "seed": 20260808,
  "stage": "A",
  "target": "drafted",
  "reuses": "config/ml3_baselines.json (folds, SET_2 membership, denied columns)",

  "selection_design": {
    "chosen": "PREDECLARED_FIXED_CONFIGURATIONS",
    "rationale": [
      "Only 7 outer folds exist, and the earliest trains on 5 years / 270 rows.",
      "Nested temporal tuning would leave roughly 2-3 years and ~150 rows for inner selection - far too noisy to choose a configuration from, and the choice would then be re-used as if unbiased.",
      "ML_SPEC and the ML-4 brief both prefer a small predeclared set over pseudo-nested tuning that leaks.",
      "Every configuration below was written down BEFORE any outer-fold result was inspected, and all are evaluated identically on all 7 folds."
    ],
    "no_random_cv": true
  },

  "outer_folds_source": "config/ml3_baselines.json",

  "feature_sets": {
    "SET_2_BOX_SHOT_PROFILE": "inherited unchanged from config/ml3_baselines.json",
    "SET_2R_REDUCED": {
      "derivation": "SET_2 minus four features removed for mathematical/structural redundancy, never by validation score",
      "removed": {
        "rim_attempt_share": "exact linear combination of layup+dunk+tip attempt shares (max deviation 0.0000000000); |r|=0.846 with layup_attempt_share",
        "efg_pct": "|r|=0.939 with ts_pct, which is strictly more complete (includes free throws); ML-3 showed the pair take opposing coefficient signs",
        "fg_pct": "|r|=0.856 with efg_pct and 0.792 with ts_pct; fully subsumed",
        "layup_make_pct": "|r|=0.821 with rim_make_pct; ML-3 coefficients were +1.09 / -0.91, a collinearity sign flip"
      }
    }
  },

  "normalization_variants": {
    "STANDARD": "train-fold StandardScaler, as ML-3",
    "SEASON_RELATIVE": {
      "description": "each covered metric replaced by its z-score against the NCAA reference distribution for the SAME season and coarse position, then train-fold StandardScaler on the remainder",
      "reference": "data/interim/ml2/ncaa_reference_distributions.parquet (ML-2)",
      "covered_metrics": ["points_per_40", "reb_per_40", "assists_per_40",
                          "steals_per_40", "blocks_per_40", "ts_pct",
                          "efg_pct", "three_point_attempt_rate",
                          "free_throw_rate", "minutes_per_game"],
      "safety": [
        "The reference uses the broad NCAA player population of that same season - pre-draft context, never a draft outcome.",
        "No future season is consulted: season Y prospects use season Y references.",
        "The same formula is applied to every draft year."
      ]
    }
  },

  "missing_strategy": "B_TRAIN_MEDIAN",
  "position_handling": "ONEHOT",

  "candidates": [
    {"id": "LR_C0.05",       "family": "LogisticRegression", "feature_set": "SET_2_BOX_SHOT_PROFILE", "norm": "STANDARD",        "class_weight": "balanced", "params": {"penalty": "l2", "C": 0.05}},
    {"id": "LR_C0.1",        "family": "LogisticRegression", "feature_set": "SET_2_BOX_SHOT_PROFILE", "norm": "STANDARD",        "class_weight": "balanced", "params": {"penalty": "l2", "C": 0.1}},
    {"id": "LR_C0.25",       "family": "LogisticRegression", "feature_set": "SET_2_BOX_SHOT_PROFILE", "norm": "STANDARD",        "class_weight": "balanced", "params": {"penalty": "l2", "C": 0.25}},
    {"id": "LR_C0.5",        "family": "LogisticRegression", "feature_set": "SET_2_BOX_SHOT_PROFILE", "norm": "STANDARD",        "class_weight": "balanced", "params": {"penalty": "l2", "C": 0.5}},
    {"id": "LR_C1.0_INCUMBENT", "family": "LogisticRegression", "feature_set": "SET_2_BOX_SHOT_PROFILE", "norm": "STANDARD",     "class_weight": "balanced", "params": {"penalty": "l2", "C": 1.0}},
    {"id": "LR_C1.0_UNWEIGHTED", "family": "LogisticRegression", "feature_set": "SET_2_BOX_SHOT_PROFILE", "norm": "STANDARD",    "class_weight": null,       "params": {"penalty": "l2", "C": 1.0}},
    {"id": "LR_C0.25_UNWEIGHTED", "family": "LogisticRegression", "feature_set": "SET_2_BOX_SHOT_PROFILE", "norm": "STANDARD",   "class_weight": null,       "params": {"penalty": "l2", "C": 0.25}},

    {"id": "LR_R_C0.1",      "family": "LogisticRegression", "feature_set": "SET_2R_REDUCED",         "norm": "STANDARD",        "class_weight": "balanced", "params": {"penalty": "l2", "C": 0.1}},
    {"id": "LR_R_C0.25",     "family": "LogisticRegression", "feature_set": "SET_2R_REDUCED",         "norm": "STANDARD",        "class_weight": "balanced", "params": {"penalty": "l2", "C": 0.25}},
    {"id": "LR_R_C1.0",      "family": "LogisticRegression", "feature_set": "SET_2R_REDUCED",         "norm": "STANDARD",        "class_weight": "balanced", "params": {"penalty": "l2", "C": 1.0}},

    {"id": "LR_L1_C0.1",     "family": "LogisticRegression", "feature_set": "SET_2_BOX_SHOT_PROFILE", "norm": "STANDARD",        "class_weight": "balanced", "params": {"penalty": "l1", "C": 0.1, "solver": "liblinear"}},
    {"id": "LR_L1_C1.0",     "family": "LogisticRegression", "feature_set": "SET_2_BOX_SHOT_PROFILE", "norm": "STANDARD",        "class_weight": "balanced", "params": {"penalty": "l1", "C": 1.0, "solver": "liblinear"}},

    {"id": "LR_SEASONREL_C0.25", "family": "LogisticRegression", "feature_set": "SET_2_BOX_SHOT_PROFILE", "norm": "SEASON_RELATIVE", "class_weight": "balanced", "params": {"penalty": "l2", "C": 0.25}},
    {"id": "LR_SEASONREL_C1.0",  "family": "LogisticRegression", "feature_set": "SET_2_BOX_SHOT_PROFILE", "norm": "SEASON_RELATIVE", "class_weight": "balanced", "params": {"penalty": "l2", "C": 1.0}},
    {"id": "LR_R_SEASONREL_C0.25", "family": "LogisticRegression", "feature_set": "SET_2R_REDUCED",       "norm": "SEASON_RELATIVE", "class_weight": "balanced", "params": {"penalty": "l2", "C": 0.25}},

    {"id": "RF_d4_leaf20",   "family": "RandomForest",       "feature_set": "SET_2_BOX_SHOT_PROFILE", "norm": "STANDARD",        "class_weight": "balanced", "params": {"n_estimators": 500, "max_depth": 4,    "min_samples_leaf": 20, "max_features": "sqrt"}},
    {"id": "RF_d6_leaf10",   "family": "RandomForest",       "feature_set": "SET_2_BOX_SHOT_PROFILE", "norm": "STANDARD",        "class_weight": "balanced", "params": {"n_estimators": 500, "max_depth": 6,    "min_samples_leaf": 10, "max_features": "sqrt"}},
    {"id": "RF_dNone_leaf30", "family": "RandomForest",      "feature_set": "SET_2_BOX_SHOT_PROFILE", "norm": "STANDARD",        "class_weight": "balanced", "params": {"n_estimators": 500, "max_depth": null, "min_samples_leaf": 30, "max_features": "sqrt"}},

    {"id": "HGB_lr005_leaf8",  "family": "HistGradientBoosting", "feature_set": "SET_2_BOX_SHOT_PROFILE", "norm": "STANDARD", "class_weight": "balanced", "params": {"learning_rate": 0.05, "max_iter": 200, "max_leaf_nodes": 8,  "min_samples_leaf": 20, "l2_regularization": 1.0}},
    {"id": "HGB_lr005_leaf4",  "family": "HistGradientBoosting", "feature_set": "SET_2_BOX_SHOT_PROFILE", "norm": "STANDARD", "class_weight": "balanced", "params": {"learning_rate": 0.05, "max_iter": 200, "max_leaf_nodes": 4,  "min_samples_leaf": 30, "l2_regularization": 5.0}},
    {"id": "HGB_lr01_leaf8",   "family": "HistGradientBoosting", "feature_set": "SET_2_BOX_SHOT_PROFILE", "norm": "STANDARD", "class_weight": null,       "params": {"learning_rate": 0.1,  "max_iter": 150, "max_leaf_nodes": 8,  "min_samples_leaf": 20, "l2_regularization": 1.0}},

    {"id": "GB_d2_lr005",    "family": "GradientBoosting",   "feature_set": "SET_2_BOX_SHOT_PROFILE", "norm": "STANDARD",        "class_weight": null,       "params": {"n_estimators": 200, "learning_rate": 0.05, "max_depth": 2, "min_samples_leaf": 20, "subsample": 0.8}},
    {"id": "GB_d3_lr005",    "family": "GradientBoosting",   "feature_set": "SET_2_BOX_SHOT_PROFILE", "norm": "STANDARD",        "class_weight": null,       "params": {"n_estimators": 200, "learning_rate": 0.05, "max_depth": 3, "min_samples_leaf": 20, "subsample": 0.8}}
  ],

  "calibration": {
    "methods": ["none", "sigmoid", "isotonic"],
    "design": "TEMPORAL_HOLDOUT",
    "description": [
      "The base estimator is fitted on every training year EXCEPT the last; the calibrator is fitted on that final held-out training year only; the calibrated model then predicts the outer validation year.",
      "sklearn's CalibratedClassifierCV default is random K-fold, which would mix years - it is deliberately NOT used.",
      "Every calibration-fit year is strictly earlier than the outer validation year; a test asserts this."
    ],
    "applied_to": "the strongest finalists only"
  },

  "notes": [
    "2026 is never loaded, predicted or evaluated.",
    "All 887 development prospects are retained; no complete-case deletion.",
    "Sparse tip/dunk ratios remain excluded (DEC-076).",
    "Results are not stored in this file."
  ]
}
